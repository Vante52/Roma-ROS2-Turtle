      material="Part__Feature074.001"
      xyz="-0.0001 0.0001 0.0053"
      rpy="-1.5708 0.0000 0.0000" />
  </link>

  <!-- Joints -->
  <xacro:fixed_joint
    name="base_to_body"
    parent="base_link"
    child="shell_link"
    xyz="0 0 0"
    rpy="0 0 0" />

  <xacro:revolute_joint
    name="neck_link_joint"
    parent="shell_link"
    child="neck_link"
    xyz="-0.0896 0.0000 -0.0056"
    rpy="0.0000 0.0000 0.0000"
    axis="0.0000 0.0000 1.0000"
    lower="-3.1400" upper="3.1400"
    effort="0.0000" velocity="0.0000" />

  <xacro:revolute_joint
    name="neck_holder_link_joint"
    parent="neck_link"
    child="neck_holder_link"
    xyz="-0.0437 0.0010 0.0469"
    rpy="-0.0000 1.5708 -0.0000"
    axis="0.0000 0.0000 1.0000"
    lower="-3.1400" upper="3.1400"
    effort="0.0000" velocity="0.0000" />

  <xacro:revolute_joint
    name="camera_link_joint"
    parent="neck_holder_link"
    child="camera_link"
    xyz="0.0002 -0.0010 -0.0469"
    rpy="1.9752 -1.5708 -0.4044"
    axis="0.0000 0.0000 1.0000"
    lower="-3.1400" upper="3.1400"
    effort="0.0000" velocity="0.0000" />

  <xacro:fixed_joint
    name="feet_right_rear_link_joint"
    parent="shell_link"
    child="feet_right_rear_link"
    xyz="0.0476 0.0521 -0.0565"
    rpy="-1.5708 0.0000 0.0000" />
  <!-- axis="0.0000 0.0000 -1.0000"
    lower="-3.1400" upper="3.1400"
    effort="0.0000" velocity="0.0000"  -->

  <xacro:continuous_joint
    name="wheel_right_rear_link_joint"
    parent="feet_right_rear_link"
    child="wheel_right_rear_link"
    xyz="0.0655 -0.0000 0.0483"
    rpy="-0.0000 0.0000 0.0000"
    axis="0.0000 0.0000 -1.0000"
    effort="10.0000" velocity="20.0000" />

  <xacro:fixed_joint
    name="feet_left_rear_link_joint"
    parent="shell_link"
    child="feet_left_rear_link"
    xyz="0.0476 -0.0522 -0.0565"
    rpy="1.5708 0.0000 -0.0000" />
  <!-- axis="0.0000 0.0000 1.0000"
    lower="-3.1400" upper="3.1400"
    effort="0.0000" velocity="0.0000"  -->

  <xacro:continuous_joint
    name="wheel_left_rear_link_joint"
    parent="feet_left_rear_link"
    child="wheel_left_rear_link"
    xyz="0.0656 0.0001 0.0488"
    rpy="0.0000 0.0000 -0.0000"
    axis="0.0000 0.0000 1.0000"
    effort="10.0000" velocity="20.0000" />

  <xacro:fixed_joint
    name="feet_left_front_link_joint"
    parent="shell_link"
    child="feet_left_front_link"
    xyz="-0.0479 -0.0522 -0.0565"
    rpy="1.5708 0.0000 -0.0000" />
  <!-- axis="0.0000 0.0000 1.0000"
    lower="-3.1400" upper="3.1400"
    effort="0.0000" velocity="0.0000"  -->

  <xacro:continuous_joint
    name="wheel_left_front_link_joint"
    parent="feet_left_front_link"
    child="wheel_left_front_link"
    xyz="-0.0655 -0.0002 0.0488"
    rpy="0.0000 0.0000 0.0000"
    axis="0.0000 0.0000 1.0000"
    effort="10.0000" velocity="20.0000" />

  <xacro:fixed_joint
    name="feet_right_front_link_joint"
    parent="shell_link"
    child="feet_right_front_link"
    xyz="-0.0479 0.0522 -0.0565"
    rpy="-1.5708 0.0000 -0.0000" />
  <!-- axis="0.0000 0.0000 -1.0000"
    lower="-3.1400" upper="3.1400"
    effort="0.0000" velocity="0.0000"  -->

  <xacro:continuous_joint
    name="wheel_right_front_link_joint"
    parent="feet_right_front_link"
    child="wheel_right_front_link"
    xyz="-0.0655 0.0002 0.0488"
    rpy="-0.0000 -0.0000 -0.0000"
    axis="0.0000 0.0000 -1.0000"
    effort="10.0000" velocity="20.0000" />

  <!-- ===== Gazebo Plugins ===== -->
  <!-- Plugin 1: Differential Drive-->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <!-- Ruedas izquierdas -->
      <left_joint>wheel_left_front_link_joint</left_joint>
      <left_joint>wheel_left_rear_link_joint</left_joint>
      <!-- Ruedas derechas -->
      <right_joint>wheel_right_front_link_joint</right_joint>
      <right_joint>wheel_right_rear_link_joint</right_joint>
      <!-- Geometría del robot -->
      <wheel_separation>0.1048</wheel_separation>
      <wheel_radius>0.020</wheel_radius>
      <!-- Tópicos -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>
  </gazebo>

  <!-- Plugin 2: Publicar estado de joints -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <left_joint>wheel_left_front_link_joint</left_joint>
      <left_joint>wheel_left_rear_link_joint</left_joint>
      <!-- Ruedas derechas -->
      <right_joint>wheel_right_front_link_joint</right_joint>
      <right_joint>wheel_right_rear_link_joint</right_joint>
    </plugin>
  </gazebo>

  <xacro:include filename="$(find roma_gazebo)/urdf/robot_material_support.xacro" />

</robot>