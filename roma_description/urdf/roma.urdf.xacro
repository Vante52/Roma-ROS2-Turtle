      material="purple"
      xyz="0.0000 0.0000 0.0000"
      rpy="-1.5708 0.0000 0.0000" />
  </link>

  <link name="wheel_left_front_link">
    <xacro:mesh_collision
      name="wheel_left_front_collision"
      mesh="${collision_mesh_dir}/Part__Feature075.019.stl"
      xyz="-0.0001 0.0001 0.0053"
      rpy="-1.5708 0.0000 0.0000" />

    <xacro:link_inertial
      mass="0.0400"
      xyz="-0.0002 0.0004 0.0047"
      rpy="0.0000 0.0000 0.0000"
      ixx="0.0000043" ixy="0.0" ixz="0.0"
      iyy="0.0000043" iyz="0.0" izz="0.0000080" />

    <xacro:mesh_visual
      name="wheel_left_front"
