<sdf version="1.9">
    <!-- Roma world -->
    <world name="flat_world">
        <!-- Physics and simulation steps -->
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <!-- Natural sun light -->
        <scene>
            <ambient>0.4 0.4 0.4 1</ambient>
            <background>0.7 0.8 1.0 1</background>
        </scene>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>

            <pose>0 0 10 0 0 0</pose>

            <diffuse>0.9 0.85 0.75 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9 </direction>
        </light>
        <!-- Ground -->
        <model name="natural_ground">
            <static>true</static>

            <link name="ground_link">

                <collision name="ground_collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>

                    <surface>
                        <friction>
                            <ode>
                                <!-- easy terrain with good grip-->
                                <mu>1.0</mu>
                                <mu2>1.0</mu2>

                                <!-- medium terrain like dry soil -->
                                <!-- <mu>0.6</mu>
                                <mu2>0.6</mu2> -->

                                <!-- Hard terrain wet soil or mud-->
                                <!-- <mu>0.3</mu>
                                <mu2>0.3</mu2> -->
                            </ode>
                        </friction>
                    </surface>
                </collision>

                <visual name="ground_visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>

                    <material>
                        <ambient>0.35 0.32 0.27 1</ambient>
                        <diffuse>0.8 0.8 1 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Reflective table</uri>
        <name>table</name>
        <pose>0 0 0.75 0 0 0</pose>
    </include> -->

    </world>
</sdf>